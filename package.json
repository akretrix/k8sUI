{
  "name": "k8s-ui",
  "private": true,
  "version": "0.1.12",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:app": "tauri build",
    "install:mac": "tauri build && cp -R src-tauri/target/release/bundle/macos/k8sUI.app /Applications/ && echo '✅ k8sUI successfully installed to /Applications/k8sUI.app'",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "launch": "./scripts/launch-local.sh",
    "check:env": "./scripts/launch-local.sh --check-only",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "check:security": "./scripts/security-check.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-table": "^8.19.3",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.418.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
